+JNI(jfloatArray, nativeTrackMono22k)(JNIEnv* env, jclass, jlong track) {
+  auto* t = reinterpret_cast<TrackPtr*>(track);
+  if (!t || (*t)->frames <= 0) return nullptr;
+  const Track& tr = **t;
+  const double ratio = static_cast<double>(tr.sampleRate) / 22050.0;
+  const jsize n = static_cast<jsize>(static_cast<double>(tr.frames) / ratio);
+  if (n <= 0) return nullptr;
+  jfloatArray arr = env->NewFloatArray(n);
+  if (!arr) return nullptr;
+  std::vector<float> out(static_cast<size_t>(n));
+  // média por área (filtro caixa) do canal esquerdo+direito: serve de passa-baixa antes de reduzir a taxa
+  for (jsize i = 0; i < n; i++) {
+    const double a = i * ratio, b = a + ratio;
+    int64_t ia = static_cast<int64_t>(a), ib = static_cast<int64_t>(b);
+    if (ib >= tr.frames) ib = tr.frames - 1;
+    double sum = 0.0, wsum = 0.0;
+    for (int64_t k = ia; k <= ib; k++) {
+      const double w = std::min<double>(k + 1, b) - std::max<double>(k, a);
+      if (w <= 0) continue;
+      sum += w * (tr.pcm[2 * k] + tr.pcm[2 * k + 1]) * 0.5;
+      wsum += w;
+    }
+    out[i] = wsum > 0 ? static_cast<float>(sum / wsum / 32768.0) : 0.f;
+  }
+  env->SetFloatArrayRegion(arr, 0, n, out.data());
+  return arr;
+}
