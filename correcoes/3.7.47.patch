+package app.djfusion.audio
+
+import ai.onnxruntime.OnnxTensor
+import ai.onnxruntime.OrtEnvironment
+import ai.onnxruntime.OrtSession
+import android.content.Context
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.nio.FloatBuffer
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.floor
+import kotlin.math.ln
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * Rede de batidas e tempos fortes (Beat This!, CPJKU, licença MIT; modelo pequeno de 2 milhões de parâmetros),
+ * rodando no aparelho com o ONNX Runtime. O modelo (~10 MB) é baixado uma vez e fica guardado; sem ele o app usa a
+ * detecção clássica ([analyzeBpm] no C++). A rede recebe o espectro em mel da faixa (22 050 Hz, 128 faixas,
+ * 50 quadros por segundo) e devolve, quadro a quadro, a chance de ter uma batida e de ser o "1" do compasso.
+ * Daí sai a grade da faixa: andamento, onde cai a primeira batida e o "1" do compasso.
+ */
+object BeatThis {
+    private const val MODEL_URL = "https://huggingface.co/ashudesai/songbird-models/resolve/main/small0.onnx"
+    private const val MIN_BYTES = 4_000_000L
+    private const val MAX_BYTES = 40_000_000L
+
+    const val SR = 22050
+    const val NFFT = 1024
+    const val HOP = 441
+    const val NMEL = 128
+    const val CHUNK = 1500
+    private const val BORDER = 6
+    const val FPS = 50.0
+
+    /** Resultado: andamento, primeiro "1" do compasso (em quadros a 48 kHz), confiança de 0 a 1 e se os tempos fortes vieram da rede. */
+    class Grid(val bpm: Double, val firstBeatFrame: Long, val confidence: Float, val hasDownbeat: Boolean, val beats: Int)
+
+    fun modelFile(ctx: Context) = File(File(ctx.filesDir, "modelos/beat_this"), "small0.onnx")
+    fun isReady(ctx: Context): Boolean = modelFile(ctx).let { it.isFile && it.length() in MIN_BYTES..MAX_BYTES }
+
+    private val lock = Any()
+    private var session: OrtSession? = null
+
+    /** Baixa e confere o modelo. Devolve null se deu certo, ou o motivo da falha. Bloqueia: chame fora da thread principal. */
+    fun download(ctx: Context): String? {
+        val dest = modelFile(ctx)
+        try {
+            dest.parentFile?.mkdirs()
+            val part = File(dest.parentFile, "small0.onnx.part")
+            val c = URL(MODEL_URL).openConnection() as HttpURLConnection
+            c.connectTimeout = 20_000
+            c.readTimeout = 30_000
+            c.instanceFollowRedirects = true
+            c.setRequestProperty("User-Agent", "EdgardGuardaDJStudio")
+            if (c.responseCode != 200) return "servidor respondeu ${c.responseCode}"
+            c.inputStream.use { ins -> part.outputStream().use { outs -> ins.copyTo(outs) } }
+            c.disconnect()
+            if (part.length() !in MIN_BYTES..MAX_BYTES) { part.delete(); return "arquivo veio incompleto (${part.length()} bytes)" }
+            if (!part.renameTo(dest)) { part.delete(); return "não consegui gravar o modelo" }
+            OrtEnvironment.getEnvironment().createSession(dest.absolutePath).close()
+            return null
+        } catch (e: Throwable) {
+            dest.delete()
+            return e.message ?: e.javaClass.simpleName
+        }
+    }
+
+    // ---------------------------------------------------------------- espectro em mel (igual ao do treino)
+
+    private val window = DoubleArray(NFFT) { 0.5 - 0.5 * cos(2.0 * PI * it / NFFT) }   // Hann periódica
+    private val cosT = DoubleArray(NFFT / 2) { cos(2.0 * PI * it / NFFT) }
+    private val sinT = DoubleArray(NFFT / 2) { -sin(2.0 * PI * it / NFFT) }
+    private val bitRev = IntArray(NFFT).also { r ->
+        val bits = 10
+        for (i in 0 until NFFT) { var x = i; var y = 0; for (b in 0 until bits) { y = (y shl 1) or (x and 1); x = x shr 1 }; r[i] = y }
+    }
+
+    private fun hzToMel(f: Double): Double {
+        val fSp = 200.0 / 3.0
+        val minLogMel = 1000.0 / fSp
+        val logStep = ln(6.4) / 27.0
+        return if (f >= 1000.0) minLogMel + ln(f / 1000.0) / logStep else f / fSp
+    }
+
+    private fun melToHz(m: Double): Double {
+        val fSp = 200.0 / 3.0
+        val minLogMel = 1000.0 / fSp
+        val logStep = ln(6.4) / 27.0
+        return if (m >= minLogMel) 1000.0 * exp(logStep * (m - minLogMel)) else fSp * m
+    }
+
+    /** Filtros triangulares em escala mel de Slaney (30 Hz a 11 kHz), sem normalizar a área, como no treino. */
+    private val bank: Array<FloatArray> by lazy {
+        val nBins = NFFT / 2 + 1
+        val mMin = hzToMel(30.0)
+        val mMax = hzToMel(11000.0)
+        val pts = DoubleArray(NMEL + 2) { melToHz(mMin + (mMax - mMin) * it / (NMEL + 1)) }
+        Array(NMEL) { m ->
+            val lo = pts[m]; val ce = pts[m + 1]; val hi = pts[m + 2]
+            FloatArray(nBins) { k ->
+                val f = k * SR.toDouble() / NFFT
+                max(0.0, min((f - lo) / (ce - lo), (hi - f) / (hi - ce))).toFloat()
+            }
+        }
+    }
+
+    /** Primeiro e último índice com peso diferente de zero em cada filtro (a maior parte é zero). */
+    private val bankSpan: Array<IntArray> by lazy {
+        Array(NMEL) { m ->
+            var lo = -1; var hi = -1
+            for (k in bank[m].indices) if (bank[m][k] > 0f) { if (lo < 0) lo = k; hi = k }
+            if (lo < 0) intArrayOf(0, -1) else intArrayOf(lo, hi)
+        }
+    }
+
+    private fun fft(re: DoubleArray, im: DoubleArray) {
+        for (i in 0 until NFFT) { val j = bitRev[i]; if (j > i) { val tr = re[i]; re[i] = re[j]; re[j] = tr; val ti = im[i]; im[i] = im[j]; im[j] = ti } }
+        var len = 2
+        while (len <= NFFT) {
+            val half = len / 2
+            val step = NFFT / len
+            var s = 0
+            while (s < NFFT) {
+                for (k in 0 until half) {
+                    val wr = cosT[k * step]; val wi = sinT[k * step]
+                    val a = s + k; val b = a + half
+                    val xr = re[b] * wr - im[b] * wi
+                    val xi = re[b] * wi + im[b] * wr
+                    re[b] = re[a] - xr; im[b] = im[a] - xi
+                    re[a] += xr; im[a] += xi
+                }
+                s += len
+            }
+            len = len shl 1
+        }
+    }
+
+    /** Espectro em mel com log: [quadros x 128], 50 quadros por segundo. */
+    fun features(x: FloatArray): FloatArray {
+        val n = x.size
+        val frames = 1 + n / HOP
+        val out = FloatArray(frames * NMEL)
+        val re = DoubleArray(NFFT)
+        val im = DoubleArray(NFFT)
+        val mag = DoubleArray(NFFT / 2 + 1)
+        val norm = 1.0 / sqrt(NFFT.toDouble())
+        for (t in 0 until frames) {
+            val start = t * HOP - NFFT / 2
+            for (i in 0 until NFFT) {
+                var idx = start + i
+                if (idx < 0) idx = -idx
+                if (idx >= n) idx = 2 * (n - 1) - idx
+                idx = idx.coerceIn(0, n - 1)
+                re[i] = x[idx] * window[i]
+                im[i] = 0.0
+            }
+            fft(re, im)
+            for (k in 0..NFFT / 2) mag[k] = sqrt(re[k] * re[k] + im[k] * im[k]) * norm
+            for (m in 0 until NMEL) {
+                val lo = bankSpan[m][0]; val hi = bankSpan[m][1]
+                var sum = 0.0
+                val w = bank[m]
+                for (k in lo..hi) sum += w[k] * mag[k]
+                out[t * NMEL + m] = ln(1.0 + 1000.0 * sum).toFloat()
+            }
+        }
+        return out
+    }
+
+    // ---------------------------------------------------------------- a rede
+
+    private fun session(ctx: Context): OrtSession = synchronized(lock) {
+        session ?: OrtEnvironment.getEnvironment().createSession(
+            modelFile(ctx).absolutePath, OrtSession.SessionOptions().apply { setIntraOpNumThreads(2) },
+        ).also { session = it }
+    }
+
+    /** Roda a rede em pedaços de 30 s (juntando só o meio de cada pedaço). Devolve (batida, tempo forte) por quadro. */
+    fun infer(ctx: Context, feat: FloatArray): Pair<FloatArray, FloatArray> {
+        val total = feat.size / NMEL
+        val beat = FloatArray(total)
+        val down = FloatArray(total)
+        val env = OrtEnvironment.getEnvironment()
+        val sess = session(ctx)
+        val inName = sess.inputNames.first()
+        val outNames = sess.outputNames.toList()
+        val iBeat = outNames.indexOfFirst { it.contains("beat", true) && !it.contains("down", true) }.let { if (it < 0) 0 else it }
+        val iDown = outNames.indexOfFirst { it.contains("down", true) }.let { if (it < 0) 1 else it }
+        val step = CHUNK - 2 * BORDER
+        var s = 0
+        while (true) {
+            val len = min(CHUNK, total - s)
+            val buf = FloatArray(CHUNK * NMEL)
+            System.arraycopy(feat, s * NMEL, buf, 0, len * NMEL)
+            OnnxTensor.createTensor(env, FloatBuffer.wrap(buf), longArrayOf(1, CHUNK.toLong(), NMEL.toLong())).use { input ->
+                sess.run(mapOf(inName to input)).use { res ->
+                    val fb = (res.get(iBeat) as OnnxTensor).floatBuffer
+                    val fd = (res.get(iDown) as OnnxTensor).floatBuffer
+                    val from = if (s == 0) 0 else BORDER
+                    val to = if (s + len >= total) len else CHUNK - BORDER
+                    for (j in from until min(to, min(fb.capacity(), fd.capacity()))) {
+                        if (s + j < total) { beat[s + j] = fb.get(j); down[s + j] = fd.get(j) }
+                    }
+                }
+            }
+            if (s + CHUNK >= total) break
+            s += step
+        }
+        return beat to down
+    }
+
+    /** Picos da saída da rede: valor acima de zero e o maior numa janela de ±3 quadros (60 ms). */
+    fun peaks(logits: FloatArray): IntArray {
+        val res = ArrayList<Int>()
+        for (i in logits.indices) {
+            if (logits[i] <= 0f) continue
+            var isMax = true
+            for (j in max(0, i - 3)..min(logits.size - 1, i + 3)) {
+                if (logits[j] > logits[i] || (logits[j] == logits[i] && j < i)) { isMax = false; break }
+            }
+            if (isMax) res.add(i)
+        }
+        return res.toIntArray()
+    }
+
+    // ---------------------------------------------------------------- grade
+
+    /**
+     * Ajusta uma grade fixa às batidas da rede (reta pelos mínimos quadrados, descartando as que fogem mais de 50 ms)
+     * e acha o "1" do compasso pelo voto dos tempos fortes. [beats] e [downs] estão em quadros de 50 por segundo.
+     * Devolve null se há batidas de menos ou o andamento não faz sentido.
+     */
+    fun fitGrid(beats: IntArray, downs: IntArray, totalFrames: Int): Grid? {
+        val n = beats.size
+        if (n < 12) return null
+        val d = DoubleArray(n - 1) { (beats[it + 1] - beats[it]).toDouble() }
+        val med = d.sorted()[d.size / 2]
+        if (med < 15.0 || med > 60.0) return null      // 200 a 50 BPM
+        val idx = IntArray(n)
+        var cur = 0
+        for (i in 1 until n) { cur += max(1, (d[i - 1] / med).roundToInt()); idx[i] = cur }
+        val inl = BooleanArray(n) { true }
+        var a = beats[0].toDouble()
+        var b = med
+        repeat(3) {
+            var sx = 0.0; var sy = 0.0; var sxx = 0.0; var sxy = 0.0; var c = 0
+            for (i in 0 until n) if (inl[i]) {
+                val x = idx[i].toDouble(); val y = beats[i].toDouble()
+                sx += x; sy += y; sxx += x * x; sxy += x * y; c++
+            }
+            val den = c * sxx - sx * sx
+            if (c < 8 || den <= 0.0) return null
+            b = (c * sxy - sx * sy) / den
+            a = (sy - b * sx) / c
+            for (i in 0 until n) inl[i] = abs(beats[i] - (a + b * idx[i])) <= 2.5
+        }
+        var k = 0
+        for (i in 0 until n) if (inl[i]) k++
+        if (k < 8 || b <= 0.0) return null
+        val coverage = min(1.0, n * b / max(1, totalFrames))
+        val conf = (k.toDouble() / n) * sqrt(coverage)
+        // o "1" do compasso: de cada tempo forte vem a posição na contagem de batidas (módulo 4)
+        val votes = IntArray(4)
+        var voted = 0
+        for (dn in downs) {
+            var best = -1; var bd = Int.MAX_VALUE
+            for (i in 0 until n) { val dd = abs(beats[i] - dn); if (dd < bd) { bd = dd; best = i } }
+            if (best >= 0 && bd <= 3) { votes[((idx[best] % 4) + 4) % 4]++; voted++ }
+        }
+        val hasDown = voted >= 3
+        var phase = 0
+        if (hasDown) for (p in 1..3) if (votes[p] > votes[phase]) phase = p
+        val bar = 4.0 * b
+        var first = a + phase * b
+        first -= floor(first / bar) * bar
+        val bpm = FPS * 60.0 / b
+        return Grid(bpm, (first * (48000.0 / FPS)).toLong(), conf.toFloat().coerceIn(0f, 1f), hasDown, n)
+    }
+
+    /** Faixa inteira (mono, 22 050 Hz) → grade. Null se faltou modelo, a faixa é curta ou a rede não achou batidas. */
+    fun analyze(ctx: Context, mono: FloatArray): Grid? {
+        if (mono.size < SR * 20) return null
+        val feat = features(mono)
+        val (bl, dl) = infer(ctx, feat)
+        return fitGrid(peaks(bl), peaks(dl), feat.size / NMEL)
+    }
+}
