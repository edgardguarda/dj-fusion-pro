+                    MetalButton(
+                        description = "Nome $n para a hot cue ${slot + 1} do deck $name",
+                        onPress = { vm.renameHotcue(deck, slot, n); vm.closeCueEdit() },
+                        led = c, ledOn = current == n,
+                        modifier = Modifier.weight(1f).fillMaxHeight(),
+                    ) { Text(n, color = Metal.OnMetal, fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, maxLines = 1, modifier = Modifier.align(Alignment.Center)) }
+                }
+            }
+            Row(Modifier.fillMaxWidth().height(40.dp), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                MetalButton(
+                    description = "Tirar o nome da hot cue ${slot + 1} do deck $name",
+                    onPress = { vm.renameHotcue(deck, slot, ""); vm.closeCueEdit() },
+                    modifier = Modifier.weight(1f).fillMaxHeight(),
+                ) { Text("SEM NOME", color = Metal.OnMetal, fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, modifier = Modifier.align(Alignment.Center)) }
+                MetalButton(
+                    description = "Apagar a hot cue ${slot + 1} do deck $name",
+                    onPress = { vm.clearHotcue(deck, slot); vm.closeCueEdit() },
+                    led = Color(0xFFFF5252), ledOn = true,
+                    modifier = Modifier.weight(1f).fillMaxHeight(),
+                ) { Text("APAGAR CUE", color = Color(0xFFFF8A80), fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, modifier = Modifier.align(Alignment.Center)) }
+                MetalButton(
+                    description = "Refazer as cues automáticas 1 a 4 do deck $name (início, groove, drop e saída)",
+                    onPress = { vm.prepareCues(deck); vm.closeCueEdit() },
+                    modifier = Modifier.weight(1f).fillMaxHeight(),
+                ) { Text("CUES AUTO", color = Metal.OnMetal, fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, modifier = Modifier.align(Alignment.Center)) }
+                MetalButton(
+                    description = "Fechar o menu da hot cue",
+                    onPress = { vm.closeCueEdit() },
+                    modifier = Modifier.weight(1f).fillMaxHeight(),
+                ) { Text("FECHAR", color = Metal.OnMetal, fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, modifier = Modifier.align(Alignment.Center)) }
+            }
+        }
+    }
+}
