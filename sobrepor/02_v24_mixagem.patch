         // só muda se o 1 for claramente mais forte (música de batida reta não tem diferença)
         return if (score[best] > others * 1.06) best else 0
     }
+
+    /**
+     * Batida do "drop": onde os graves voltam com mais força depois de uma parte mais vazia (break).
+     * Procura em compassos (4 batidas), entre [fromBeat] e [toBeat]; -1 se não houver uma volta clara.
+     */
+    fun dropBeat(wave: ByteArray?, firstBeat: Long, beatFrames: Double, fromBeat: Int, toBeat: Int): Int {
+        val low = bandPerBeat(wave, firstBeat, beatFrames, 0)
+        if (low.size < 48) return -1
+        val ref = median(low)
+        if (ref <= 0f) return -1
+        var best = -1
+        var bestScore = 0.0
+        var b = ((fromBeat + 3) / 4) * 4
+        val end = minOf(toBeat, low.size - 8)
+        while (b in 16..end) {
+            var after = 0.0; var before = 0.0
+            for (k in 0 until 8) after += low[b + k]
+            for (k in 1..16) before += low[b - k]
+            after /= 8.0; before /= 16.0
+            // depois forte (perto do normal) e antes vazio: a volta do break
+            if (after >= ref * 0.85 && before < ref * 0.6) {
+                val score = after - before
+                if (score > bestScore) { bestScore = score; best = b }
+            }
+            b += 4
+        }
+        return best
+    }
 }
