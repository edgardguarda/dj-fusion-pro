+// Três efeitos ao mesmo tempo no deck: o encaixe vazio não muda nada; dois encaixes somam.
+static void testFxSlots() {
+  auto tr = makeSine(kSr * 4, 330, 0.4f);
+  for (int64_t i = 0; i < tr->frames; ++i) if ((i % (kSr / 2)) > kSr / 20) { tr->pcm[2 * i] = 0; tr->pcm[2 * i + 1] = 0; }
+  Engine one(kSr, 480), two(kSr, 480), off(kSr, 480);
+  for (Engine* e : {&one, &two, &off}) { e->loadTrack(0, tr); e->setCrossfader(0.f); e->setMaster(1.f); e->play(0); e->setFx(0, DeckFx::Echo, 1.f, 0.5, 0); }
+  two.setFx(0, DeckFx::Reverb, 1.f, 0.5, 2);
+  off.setFx(0, DeckFx::Off, 1.f, 0.5, 1);
+  off.setFx(0, DeckFx::Reverb, 1.f, 0.5, 7);   // encaixe inválido: ignorado
+  auto a = renderN(one, kSr * 2), b = renderN(two, kSr * 2), c = renderN(off, kSr * 2);
+  double d2 = 0, d0 = 0, ref = 0;
+  for (size_t i = kSr / 2; i < a.size(); ++i) { d2 += (a[i] - b[i]) * (a[i] - b[i]); d0 += (a[i] - c[i]) * (a[i] - c[i]); ref += a[i] * a[i]; }
+  std::printf("  eco + reverb em encaixes separados: mudança %.2f (encaixe vazio %.4f)\n", std::sqrt(d2 / ref), std::sqrt(d0 / ref));
+  CHECK(std::sqrt(d2 / ref) > 0.2);
+  CHECK(std::sqrt(d0 / ref) < 1e-4);
+}
+
+// Curvas do crossfader: suave (-3 dB no meio), mixagem (cheio no meio) e corte (abre no começo do curso).
+static void testXfCurves() {
+  auto peakA = [](int curve, float x) {
+    Engine e(kSr, 480);
+    e.loadTrack(0, makeSine(kSr * 2, 440, 0.5f)); e.setMaster(1.f); e.setCrossfaderCurve(curve); e.setCrossfader(x); e.play(0);
+    renderN(e, kSr / 2);
+    auto o = renderN(e, kSr / 4);
+    double p = 0; for (float v : o) p = std::max(p, (double)std::fabs(v));
+    return p;
+  };
+  const double full = peakA(0, 0.f);
+  const double s = peakA(0, 0.5f) / full, m = peakA(1, 0.5f) / full, c = peakA(2, 0.9f) / full, cEnd = peakA(2, 1.f) / full;
+  std::printf("  crossfader no meio: suave %.2f, mixagem %.2f; corte em 90%%: %.2f, no fim: %.2f\n", s, m, c, cEnd);
+  CHECK(std::fabs(s - 0.707) < 0.03);
+  CHECK(std::fabs(m - 1.0) < 0.03);
+  CHECK(std::fabs(c - 1.0) < 0.03);
+  CHECK(cEnd < 0.01);
+}
