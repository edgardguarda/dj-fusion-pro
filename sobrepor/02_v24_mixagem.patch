+        if (!force && (0..3).any { d.hotcues[it] >= 0 }) return
+        val beat = 60.0 * NativeEngine.SAMPLE_RATE / d.bpm
+        val shape = app.djfusion.harmony.TrackShape
+        val bar = 4 * beat
+        fun atBeat(b: Int): Long = (d.firstBeatFrame + b * beat).toLong()
+        val startFrame = shape.musicalStart(d.wave)
+        val startBeat = kotlin.math.max(0.0, Math.floor((startFrame - d.firstBeatFrame) / bar) * 4).toInt()
+        val endFrame = shape.musicalEnd(d.wave, d.lengthFrames)
