+        val groove = shape.grooveBeat(d.wave, d.firstBeatFrame, beat)
+        val outro = shape.outroBeat(d.wave, d.firstBeatFrame, beat, totalBeats)
+        val drop = shape.dropBeat(d.wave, d.firstBeatFrame, beat, groove + 32, if (outro > 0) outro - 16 else totalBeats - 32)
