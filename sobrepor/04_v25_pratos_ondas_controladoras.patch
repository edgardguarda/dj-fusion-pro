+  Engine a(kSr, 480), b(kSr, 480);
+  for (Engine* x : {&a, &b}) { x->loadTrack(0, makeSine(kSr * 10, 440, 0.5f)); x->setMaster(1.f); x->setCrossfader(0.f); x->play(0); renderN(*x, 4800); }
+  b.nudge(0, 2400.0);
