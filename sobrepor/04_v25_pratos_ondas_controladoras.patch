+// Jog de controladora: scratch por posição chega ao ponto exato e para; o empurrão adianta a música sem mudar o pitch.
+static void testJogPosition() {
+  Engine e(kSr, 480);
+  e.loadTrack(0, makeSine(kSr * 10, 440, 0.5f)); e.setMaster(1.f); e.setCrossfader(0.f);
+  e.seekFrames(0, kSr * 2); renderN(e, 4800);
+  const int64_t p0 = e.deckInfo(0).positionFrames;
+  for (int k = 0; k < 10; ++k) { e.scratchMove(0, 480.0); renderN(e, 240); }   // 10 passos de 10 ms
+  renderN(e, kSr / 10);
+  const int64_t p1 = e.deckInfo(0).positionFrames;
+  for (int k = 0; k < 5; ++k) { e.scratchMove(0, -960.0); renderN(e, 240); }
+  renderN(e, kSr / 10);
+  const int64_t p2 = e.deckInfo(0).positionFrames;
+  renderN(e, kSr / 10);
+  const int64_t p3 = e.deckInfo(0).positionFrames;
+  std::printf("  jog por posição: +%lld (esperado +4800), volta %lld (esperado -4800), parado: %lld\n",
+              (long long)(p1 - p0), (long long)(p2 - p1), (long long)(p3 - p2));
+  CHECK(std::llabs((p1 - p0) - 4800) < 24);
+  CHECK(std::llabs((p2 - p1) + 4800) < 24);
