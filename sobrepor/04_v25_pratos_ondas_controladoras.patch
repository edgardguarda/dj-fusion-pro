+  const int64_t diff = b.deckInfo(0).positionFrames - a.deckInfo(0).positionFrames;
+  bool fin = true; for (float v : ob) fin = fin && std::isfinite(v);
+  std::printf("  empurrão do prato: +%lld quadros (esperado +2400)\n", (long long)diff);
