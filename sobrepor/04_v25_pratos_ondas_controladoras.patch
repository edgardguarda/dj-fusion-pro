+/** Batidas do outro deck projetadas na onda deste (só com os dois andamentos e o outro tocando). */
+internal fun ghostBeats(vm: AppViewModel, deck: Int, live: State<LiveUi>): GhostBeats? {
+    val all = vm.decks.value
+    val me = all[deck]
+    val ot = all[1 - deck]
+    if (!me.loaded || !me.hasBpm || !ot.loaded || !ot.hasBpm || !ot.playing) return null
+    val beat2 = 48000.0 * 60.0 / ot.bpm
+    val p2 = live.value.decks[1 - deck].positionFrames
+    if (p2 < ot.firstBeatFrame) return null
+    val rel = (p2 - ot.firstBeatFrame) / beat2
+    val idx = Math.floor(rel).toLong()
+    val myPerSec = 48000.0 * me.rate
+    val otPerSec = 48000.0 * ot.rate
+    return GhostBeats(
+        periodFrames = beat2 / otPerSec * myPerSec,
+        nextFrames = (idx + 1 - rel) * beat2 / otPerSec * myPerSec,
+        nextIndex = idx + 1,
+        color = deckColor(1 - deck),
+    )
+}
