+private fun bassLane(peaks: ByteArray?, width: Int): ByteArray {
+    if (peaks == null || width <= 0) return ByteArray(0)
+    val bins = peaks.size / 3
+    if (bins < width) return ByteArray(0)
+    val avg = FloatArray(width)
+    for (x in 0 until width) {
+        val from = (x.toLong() * bins / width).toInt()
+        val to = max(from + 1, ((x + 1).toLong() * bins / width).toInt()).coerceAtMost(bins)
+        var sum = 0f
