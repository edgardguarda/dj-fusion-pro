+        avg[x] = sum / (to - from)
+    }
+    val ref = avg.filter { it > 4f }.sorted().let { if (it.isEmpty()) 0f else it[(it.size * 0.6f).toInt().coerceAtMost(it.size - 1)] }
+    if (ref <= 0f) return ByteArray(0)
+    return ByteArray(width) { x -> (when { avg[x] >= ref * 0.6f -> 2; avg[x] >= ref * 0.3f -> 1; else -> 0 }).toByte() }
